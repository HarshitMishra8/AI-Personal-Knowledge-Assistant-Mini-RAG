# Backend settings. Copy to .env (never commit .env).

# Required in production. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Database. Leave unset for a local SQLite file; use Postgres + pgvector in production
# (e.g. a Neon connection string; postgres:// URLs are accepted as-is).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# LLM: any OpenAI-compatible API. Leave LLM_API_KEY empty to run in retrieval-only mode.
# Groq (free tier):
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# OpenAI:  LLM_BASE_URL unset, LLM_MODEL=gpt-4o-mini
# Ollama (local):  LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY=ollama, LLM_MODEL=llama3.1

# Google sign-in (optional). OAuth client ID from Google Cloud Console; the frontend needs the same value.
GOOGLE_CLIENT_ID=

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGIN_REGEX=^https://pagewise(-[a-z0-9-]+)?\.vercel\.app$

# Optional tuning
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# TOP_K=5
# MIN_SCORE=0.3
# MAX_UPLOAD_MB=20
# ACCESS_TOKEN_EXPIRE_MINUTES=10080
